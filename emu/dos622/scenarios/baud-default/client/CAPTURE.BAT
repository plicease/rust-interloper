@ECHO OFF
REM The dir-copy steps with no /BAUD on either side, so both use their
REM default maximum (115200) and any speed negotiation shows in the capture.
MODE COM2:9600,N,8,1 > NUL
IF NOT EXIST C:\CAP\NUL MD C:\CAP
ECHO CAPTURE-START> COM2
ECHO DIR D:\FIXTURE> COM2
DIR D:\FIXTURE
ECHO COPY D:\FIXTURE\README.TXT> COM2
COPY D:\FIXTURE\README.TXT C:\CAP
ECHO COPY D:\FIXTURE\BIG.BIN> COM2
COPY D:\FIXTURE\BIG.BIN C:\CAP
ECHO CAPTURE-DONE> COM2
ECHO CAPTURE-DONE
