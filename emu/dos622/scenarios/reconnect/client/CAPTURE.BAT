@ECHO OFF
REM Reconnects: capture.py restarts the client (a fresh INTERLNK meets a
REM server that is mid-session), then the server (INTERLNK loses its server
REM and a fresh INTERSVR starts). C:\CAP\PHASE2 marks the second boot.
MODE COM2:9600,N,8,1 > NUL
IF NOT EXIST C:\CAP\NUL MD C:\CAP
IF EXIST C:\CAP\PHASE2 GOTO PHASE2
ECHO CAPTURE-START> COM2
ECHO DIR D:\FIXTURE> COM2
DIR D:\FIXTURE
ECHO PHASE2> C:\CAP\PHASE2
ECHO HOST-RESTART-CLIENT> COM2
REM Wait here until capture.py resets the VM.
CHOICE /C:X /T:X,99 > NUL
CHOICE /C:X /T:X,99 > NUL
ECHO NO-RESTART> COM2
GOTO END

:PHASE2
ECHO CLIENT-RESTARTED> COM2
ECHO DIR D:\FIXTURE> COM2
DIR D:\FIXTURE
ECHO HOST-RESTART-SERVER> COM2
REM Give the server time to boot and start INTERSVR again.
CHOICE /C:X /T:X,60 > NUL
ECHO DIR D:\FIXTURE> COM2
DIR D:\FIXTURE
ECHO COPY D:\FIXTURE\README.TXT> COM2
COPY D:\FIXTURE\README.TXT C:\CAP

:END
ECHO CAPTURE-DONE> COM2
ECHO CAPTURE-DONE
